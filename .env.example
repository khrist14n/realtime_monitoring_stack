# Copy to .env and fill in. Never commit .env.

# PagerDuty Events API v2 integration key ("routing key").
# Create one in PagerDuty: Integrations -> Events API v2.
# If left empty the stack still deploys, but the Alertmanager PagerDuty
# receiver is generated with a placeholder and validation will warn.
PAGERDUTY_ROUTING_KEY=

# Grafana admin credentials (consumed by docker-compose.yml)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Hosts used by the deploy health checks / CLI (defaults match compose ports)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
LOKI_URL=http://localhost:3100

# Container engine for compose commands: 'docker' (default) or 'podman'.
# When unset, the CLI auto-detects: docker first, then podman.
MONITORING_STACK_RUNTIME=docker